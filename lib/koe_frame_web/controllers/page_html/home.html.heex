<Layouts.flash_group flash={@flash} />

<main class="min-h-screen bg-base-200 text-base-content">
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-16 lg:px-8">
    <header class="flex items-center justify-between gap-4 border-b border-base-300 pb-5">
      <div>
        <p class="font-mono text-xs text-base-content/60">PRIVATE MEDIA WORKSPACE</p>
        <p class="mt-1 text-lg font-semibold">KoeFrame</p>
      </div>
      <Layouts.theme_toggle />
    </header>

    <div class="grid gap-10 py-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)] lg:items-center lg:py-20">
      <section class="max-w-2xl">
        <p class="text-sm font-medium text-primary">Instance workspace</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">KoeFrame</h1>
        <p class="mt-5 max-w-xl text-lg leading-8 text-base-content/70">
          Private video intake, localization, and library management for your collection.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/admin" class="btn btn-primary">Open admin</a>
          <span class="text-sm text-base-content/60">Administrator sign-in required</span>
        </div>
      </section>

      <aside class="rounded-box border border-base-300 bg-base-100 p-5 sm:p-6">
        <h2 class="text-base font-semibold">Identity checks</h2>
        <p class="mt-2 text-sm leading-6 text-base-content/70">
          The admin workspace can check OIDC discovery, the PKCE setup client, the Auth first-admin preflight, and the stored admin login registration.
        </p>
        <p class="mt-4 border-t border-base-300 pt-4 text-sm leading-6 text-base-content/60">
          The first-admin preflight is read-only and does not create an IAM user.
        </p>
      </aside>
    </div>
  </div>
</main>

<main class="min-h-screen bg-base-200 text-base-content">
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="rounded-box border border-base-300 bg-base-100 p-6 sm:p-9">
      <p class="font-mono text-xs text-base-content/60">KOEFRAME ADMIN</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight">Administrator access required</h1>
      <p class="mt-4 leading-7 text-base-content/70">
        Your identity was verified, but it does not carry KoeFrame's administrator permission.
        Ask your identity administrator to grant the configured admin scope, then sign in again.
      </p>
      <a class="btn btn-primary mt-7" href="/">Return to KoeFrame</a>
    </div>
  </section>
</main>
